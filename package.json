{
  "name": "mave",
  "version": "0.1.0",
  "private": true,
  "description": "MAVE - Always-ready personal AI voice assistant with English-learning capabilities",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mave/desktop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:antigravity:live": "tsx scripts/test-antigravity-live.ts",
    "test:e2e": "turbo run test:e2e --filter=@mave/desktop",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.11.2"
}
