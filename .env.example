# MAVE Environment Variables Placeholder
# Future Milestones
OPENAI_API_KEY=

# Wake Word Settings (openWakeWord - runs locally, no API key needed)
# MAVE_WAKE_MODEL_PATH=assets/wake/mave.onnx

# Application Settings (optional)
NODE_ENV=development
LOG_LEVEL=info

# Fast Brain (OpenAI-compatible): groq | cerebras | gemini | openrouter | openai | ollama | lmstudio | custom
# MAVE_FAST_BRAIN=groq
# MAVE_FAST_BRAIN_API_KEY=
# MAVE_FAST_BRAIN_MODEL=
# MAVE_FAST_BRAIN_BASE_URL=
# MAVE_DEFAULT_BRAIN=fast

# Tools (M5): folders MAVE may touch, separated by ;
# MAVE_TOOL_ROOTS=C:\project

# Surface (M4)
# MAVE_HOTKEY=Control+Alt+M
# MAVE_SURFACE=0
# MAVE_CONSOLE=0
