# MAVE Environment Variables Placeholder
# Future Milestones
OPENAI_API_KEY=

# Wake Word Settings (openWakeWord - runs locally, no API key needed)
# MAVE_WAKE_MODEL_PATH=assets/wake/mave.onnx

# Application Settings (optional)
NODE_ENV=development
LOG_LEVEL=info

# Fast Brain (OpenAI-compatible): groq | cerebras | gemini | openrouter | openai | ollama | lmstudio | custom
# MAVE_FAST_BRAIN=groq
# MAVE_FAST_BRAIN_API_KEY=
# MAVE_FAST_BRAIN_MODEL=
# MAVE_FAST_BRAIN_BASE_URL=
# MAVE_DEFAULT_BRAIN=fast

# Tools (M5): folders MAVE may touch, separated by ;
# MAVE_TOOL_ROOTS=C:\project

# Surface (M4)
# MAVE_HOTKEY=Control+Alt+M
# MAVE_SURFACE=0
# MAVE_CONSOLE=0

# Thai/English local TTS: VoxCPM2 (openbmb/VoxCPM2, Apache-2.0). Falls back to edge-tts if it can't load.
# Reuse the venv and model cache from the AF video project:
# MAVE_TTS_ENGINE=voxcpm
# MAVE_TTS_PYTHON=D:\AF\tools\tts-venv\Scripts\python.exe
# HF_HOME=D:\AF\tools\hf-cache
# MAVE_VOXCPM_MODEL=openbmb/VoxCPM2
# MAVE_VOXCPM_REFERENCE_WAV=D:\AF\voices\mave.wav
# MAVE_VOXCPM_PROMPT_WAV=
# MAVE_VOXCPM_PROMPT_TEXT=
# MAVE_VOXCPM_VOICE_DESIGN=A young Thai woman, warm, clear and friendly
# MAVE_VOXCPM_STEPS=10
# MAVE_VOXCPM_CFG=2.0
